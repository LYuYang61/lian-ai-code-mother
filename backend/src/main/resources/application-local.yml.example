# 本文件只提供配置模板，不填写任何密钥。
# 复制为 application-local.yml（该文件已被 .gitignore 忽略），并在 Windows 环境变量中设置：
#   DEEPSEEK_API_KEY=<本机密钥>
# 然后使用 SPRING_PROFILES_ACTIVE=local 启动后端。

spring:
  config:
    activate:
      on-profile: local
  datasource:
    # Windows MySQL 8 示例；不要把真实密码写入此模板。
    url: ${MYSQL_URL:jdbc:mysql://127.0.0.1:3306/lian_ai_code?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true}
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  session:
    store-type: redis
    timeout: ${SESSION_TIMEOUT:30d}
    redis:
      namespace: ${SPRING_SESSION_REDIS_NAMESPACE:lian:session}
      flush-mode: on_save
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      username: ${REDIS_USERNAME:}
      password: ${REDIS_PASSWORD:}
      database: ${REDIS_DATABASE:0}

mybatis-flex:
  mapper-locations: classpath:/mapper/**/*.xml

langchain4j:
  open-ai:
    chat-model:
      api-key: ${DEEPSEEK_API_KEY}
    streaming-chat-model:
      api-key: ${DEEPSEEK_API_KEY}
