<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lian.aicode</groupId>
    <artifactId>lian-ai-code-mother-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lian-ai-code-mother-backend</name>
    <description>lian-ai-code-mother learning backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- 与 qing-ai-agent 当前可用配置保持一致的 Knife4j OpenAPI 3 Jakarta starter。 -->
        <knife4j.version>4.5.0</knife4j.version>
        <hutool.version>5.8.47</hutool.version>
        <!-- LangChain4j 核心与 Spring/Reactor 扩展使用官方配套版本。 -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <langchain4j.spring.version>1.20.0-beta30</langchain4j.spring.version>
        <!-- Spring Boot 3 使用 Jakarta 版本的 MyBatis-Flex starter。 -->
        <mybatis-flex.version>1.11.8</mybatis-flex.version>
    </properties>

    <dependencies>
        <!-- Web MVC、JSON 和内置 Tomcat。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 为后续鉴权、限流和日志切面预留；本期不编写业务切面。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- DTO 参数校验；校验失败由全局异常处理器统一转成业务响应。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Hikari 数据源和 Spring JDBC；MyBatis-Flex starter 本身不替代 Boot JDBC starter。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Spring Data Redis：承载 AI 对话记忆和可选的分布式 Session。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Boot 3.5 对应的 Spring Session Redis 模块，版本由 Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Flex 负责实体映射、条件构造和分页，不引入 MyBatis-Plus 的包名。 -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
            <version>${mybatis-flex.version}</version>
        </dependency>

        <!-- 只引入密码编码器，不启用 Spring Security 默认的 Web 登录拦截器。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- MySQL 8 驱动；真实 local profile 使用它连接业务数据库，测试 profile 改用 H2。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot 统一管理 Lombok 版本，避免手动覆盖与 JDK 21 不匹配的旧版本。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!--
            LangChain4j 核心 API（AI Services、消息模型和结构化输出）。
            注意它与 Spring AI、LangGraph4j 是不同生态，不能混用 groupId/artifactId。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- OpenAI 兼容协议模型的 Spring Boot 3 starter，DeepSeek 可通过 base-url 接入。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.spring.version}</version>
        </dependency>
        <!-- 将 TokenStream 适配为 Reactor Flux<String>，供后续 SSE 使用。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j.spring.version}</version>
        </dependency>

        <!-- 缓存按应用隔离的 AI Service，设置容量和过期策略避免本地内存无限增长。 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Knife4j OpenAPI 3 Jakarta starter，提供增强后的中文接口文档页面。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试使用 H2 的 MySQL 兼容模式，避免测试依赖开发机上的 MySQL。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- OpenAPI 生成器需要方法参数名时，显式保留编译参数元数据。 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
